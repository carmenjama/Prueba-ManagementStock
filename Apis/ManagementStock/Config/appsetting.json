{
  "Application": {
    "Name": "ManagementProducts Api",
    "Code": "management-products",
    "Version": "1.0",
    "IsProduction": true
  },
  "SqlServerContext": {
    "ConnectionString": "Data Source=[__[SQL_SERVER_NAME]__];Initial Catalog=ManagementStock;User ID=[__[SQL_DB_USER]__]; password=[__[SQL_DB_PASS]__]; integrated security=False;MultipleActiveResultSets=True;App=EntityFramework; Encrypt=False"
  },
  "ApiSettings": {
    "ThreadsSettings": {
      "CompletionPorts": 8,
      "Workers": 8
    },
    "TokenSettings": {
      "RefreshTokenExpirationTimeInMinutes": 360,
      "AccessTokenExpirationTimeInMinutes": 240
    }
  },
  "JwtToken": {
    "Key": "[__[JWT_KEY]__]",
    "AudienceToken": "[__[JWT_AUDIENCE]__]",
    "IsUserToken": "[__[JWT_USER_TOKEN]__]",
    "ExpireMinutes": 90,
    "Expire": true,
    "UserName": "[__[JWT_USERNAME]__]",
    "Pass": "[__[JWT_PASS]__]"
  }
}